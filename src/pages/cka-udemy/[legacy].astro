---
// 번호를 제거하기 전 CKA 실습 주소를 보존한다. hash는 서버에 전달되지 않아 브라우저에서 매핑한다.
import routes from '../../data/cka-udemy-legacy-routes.json';

export function getStaticPaths() {
  return Object.entries(routes).map(([legacy, route]) => ({ params: { legacy }, props: route }));
}
const { target, anchors } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`1;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>CKA 실습 문서 이동</title>
    <script is:inline define:vars={{ target, anchors }}>
      let hash = location.hash.slice(1);
      try { hash = decodeURIComponent(hash); } catch {}
      location.replace(anchors[hash] || target + location.hash);
    </script>
  </head>
  <body><p>문서 주소가 변경되었습니다. <a href={target}>새 페이지로 이동</a></p></body>
</html>
