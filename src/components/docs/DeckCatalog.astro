---
/*
  랜딩(/)의 덱 목록 — 태그 필터 · 카테고리 카드 · 정렬 가능한 테이블.

  카드 보기는 덱을 카테고리로 묶어 처음 둘러보기 좋게 하고,
  테이블 보기는 덱이 많을 때 전체를 빠르게 비교하게 한다.
  기본 보기는 테이블이고 최근 수정일 내림차순으로 렌더한다 — "최근에 뭘 봤지"가
  이 사이트의 첫 질문이라서다. 테이블의 카테고리와 최근 수정일 제목행은 버튼이며,
  누를 때마다 오름차순과 내림차순을 바꾼다. 현재 보기는 localStorage에 저장한다.
  좁은 화면에서는 카테고리·분량 열을 접어 가로 스크롤 없이 덱과 최근 수정일만 남긴다.

  카테고리는 굵은 묶음이고, 카테고리를 가로지르는 축(온프렘·실습·인증 같은)은
  태그가 맡는다. 필터는 교집합(AND)이다 — 덱 23개에서 합집합은 대부분을 남겨
  필터가 아무 일도 안 하는 것처럼 보인다. 대신 AND는 막다른 길이 생기므로
  선택이 바뀔 때마다 남은 칩의 개수를 다시 세고, 0이 되는 칩은 흐리게 한다.

  태그 선택은 localStorage에 저장하지 않는다. 보기 전환은 지속되는 취향이지만
  태그는 그때의 질의라, 저장하면 다음에 왔을 때 덱 대부분이 말없이 사라진다.
  대신 '?tags=k8s,onprem'으로 URL에 남겨 링크가 되게 한다(replaceState).

  sections: 카테고리 하나 = 섹션 하나
    title  카테고리 이름 (h2)
    desc   카테고리 한 줄 설명
    tone   DeckMap과 같은 여섯 의미 팔레트(docs/content-authoring.md) — 카테고리 식별색
    decks  덱 카드 목록
      slug      덱 slug — 수정일을 계산할 콘텐츠 경로
      href      덱 index 링크 ('/cka/')
      icon      Starlight 아이콘 이름 — src/data/decks.mjs의 topic과 같은 값
      title     덱 이름
      desc      한 줄 소개 (평문 — 서식 처리 없음)
      chapters  장 수 — 카드 오른쪽 위 분량 표시
      tags      해석된 {id, label, axis} — 카드·행의 라벨이자 필터 대상
  facets: 필터 칩 — sections의 태그와 같은 어휘에 전체 기준 count가 붙은 것
  axes:   칩을 묶는 축 (주제 · 형식 · 환경)

  각 덱의 최종 수정일은 Starlight가 페이지 수정일에 쓰는 Git 이력에서 가져온다.
  파일 시스템 mtime은 배포 체크아웃 시각으로 바뀌므로 사용하지 않는다. 덱의 index와
  등록된 장 중 하나라도 커밋되면 가장 최신 날짜가 자동으로 카드에 반영된다.

  덱을 추가하면 src/data/decks.mjs 한 곳만 고친다.
*/
import { Icon } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import { getNewestCommitDate } from 'virtual:starlight/git-info';

type Tone = 'key' | 'ok' | 'warn' | 'bad' | 'mute' | 'zone';

interface Tag {
  id: string;
  label: string;
  axis: string;
}

interface Deck {
  slug: string;
  href: string;
  icon: string;
  title: string;
  desc: string;
  chapters: number;
  tags: Tag[];
}

interface Section {
  title: string;
  desc: string;
  tone: Tone;
  decks: Deck[];
}

interface Props {
  sections: Section[];
  facets: (Tag & { count: number })[];
  axes: { id: string; label: string }[];
}

const { sections, facets, axes } = Astro.props;
const docs = await getCollection('docs');

const sectionsWithDates = sections.map((section) => ({
  ...section,
  decks: section.decks.map((deck) => {
    const dates = docs
      .filter((entry) => entry.id === deck.slug || entry.id.startsWith(`${deck.slug}/`))
      .flatMap((entry) => {
        try {
          return [getNewestCommitDate(entry.filePath)];
        } catch {
          // 새 파일처럼 아직 Git 이력이 없는 문서는 날짜 계산에서 제외한다.
          return [];
        }
      });

    return {
      ...deck,
      updatedAt: dates.length > 0 ? new Date(Math.max(...dates.map((date) => date.getTime()))) : undefined,
    };
  }),
}));

// 초기 렌더가 곧 기본 정렬이다 — 최근 수정일 내림차순, 수정일 없는 덱은 마지막.
// sort는 안정 정렬이라 동률(같은 날짜·둘 다 없음)은 manifest 순서를 유지한다.
const tableDecks = sectionsWithDates
  .flatMap((section) =>
    section.decks.map((deck) => ({
      ...deck,
      category: section.title,
      tone: section.tone,
    })),
  )
  .sort((a, b) => (b.updatedAt?.getTime() ?? 0) - (a.updatedAt?.getTime() ?? 0));

const formatDate = (date: Date) =>
  date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
    timeZone: 'Asia/Seoul',
  });

const tagIds = (deck: { tags: Tag[] }) => deck.tags.map((tag) => tag.id).join(' ');
---

<div class="catalog" data-deck-catalog>
  {/* 필터가 툴바 위에 온다 — 필터는 "무엇을", 보기 전환은 "어떻게"다.
      data-pagefind-ignore: 랜딩도 색인 대상이라, 두지 않으면 '온프렘'·'실습' 같은
      칩 라벨 때문에 '/'가 진짜 덱 페이지와 검색 순위를 다툰다. */}
  <div class="catalog__filter" data-tag-filter data-pagefind-ignore role="group" aria-label="태그 필터">
    {axes.map((axis) => (
      <div class="filter__axis" role="group" aria-label={axis.label}>
        {/* 바깥 role="group"이 이미 같은 이름을 갖고 있어 중복해 읽히지 않게 감춘다 */}
        <span class="filter__axis-label" aria-hidden="true">{axis.label}</span>
        {facets
          .filter((facet) => facet.axis === axis.id)
          .map((facet) => (
            <button class="filter__chip" type="button" data-tag={facet.id} data-axis={facet.axis} aria-pressed="false">
              {facet.label}
              <span class="filter__count" data-chip-count>{facet.count}</span>
            </button>
          ))}
      </div>
    ))}
    <button class="filter__clear" type="button" data-filter-clear hidden>필터 지우기</button>
  </div>

  <div class="catalog__toolbar" role="group" aria-label="덱 표시 방식" data-pagefind-ignore>
    <span class="catalog__toolbar-label">보기</span>
    <div class="catalog__view-switch">
      <button class="catalog__view-button" type="button" data-view-button="cards" aria-pressed="false">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <rect x="1.5" y="1.5" width="5" height="5" rx="1"></rect>
          <rect x="9.5" y="1.5" width="5" height="5" rx="1"></rect>
          <rect x="1.5" y="9.5" width="5" height="5" rx="1"></rect>
          <rect x="9.5" y="9.5" width="5" height="5" rx="1"></rect>
        </svg>
        카드
      </button>
      <button class="catalog__view-button" type="button" data-view-button="table" aria-pressed="true">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 3.5h12M2 8h12M2 12.5h12"></path>
        </svg>
        테이블
      </button>
    </div>
  </div>

  {/* 기본 보기가 테이블이라 카드 패널은 hidden으로 시작한다. Pagefind는 hidden이어도
      빌드된 HTML을 읽으므로 랜딩 색인은 여전히 이쪽(카드)이 담당한다. */}
  <div data-catalog-view="cards" hidden>
    {sectionsWithDates.map((section) => (
      <section class="catalog__section" data-tone={section.tone}>
        <header class="catalog__head">
          <h2 class="catalog__title">{section.title}</h2>
          <p class="catalog__desc">{section.desc}</p>
        </header>
        <div class="catalog__grid">
          {section.decks.map((deck) => (
            <a class="deck" href={deck.href} data-tags={tagIds(deck)}>
              <span class="deck__icon" aria-hidden="true">
                <Icon name={deck.icon as any} size="1.25rem" />
              </span>
              <span class="deck__body">
                <span class="deck__row">
                  <span class="deck__name">{deck.title}</span>
                  <span class="deck__meta">{deck.chapters}장</span>
                </span>
                <span class="deck__blurb">{deck.desc}</span>
                {deck.updatedAt && (
                  <span class="deck__updated">
                    마지막 수정 <time datetime={deck.updatedAt.toISOString()}>{formatDate(deck.updatedAt)}</time>
                  </span>
                )}
                {/* 카드 전체가 <a>다 — 여기의 태그는 라벨이지 버튼이 아니다.
                    앵커 안에 버튼을 중첩하면 잘못된 HTML이고 키보드 탐색이 깨진다.
                    필터 바와 같은 이유로 색인에서 뺀다 — 카드마다 반복되므로
                    이쪽이 오히려 랜딩의 검색 무게를 더 키운다. */}
                <span class="deck__tags" data-pagefind-ignore>
                  {deck.tags.map((tag) => (
                    <span class="deck__tag" data-axis={tag.axis}>{tag.label}</span>
                  ))}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  {/* 테이블 보기는 카드 보기와 같은 제목·설명을 한 번 더 실을 뿐이라 통째로 색인에서 뺀다.
      hidden이어도 Pagefind는 빌드된 HTML을 그대로 읽으므로 붙이지 않으면 두 번 실린다. */}
  <div class="catalog-table-wrap" data-catalog-view="table" data-pagefind-ignore>
    <table class="catalog-table">
      <thead>
        <tr>
          <th scope="col">덱</th>
          <th scope="col" data-sort-header="category" aria-sort="none">
            <button class="catalog-table__sort" type="button" data-sort="category">
              카테고리
              <span class="catalog-table__sort-icon" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col">분량</th>
          {/* 초기 행 순서(서버 정렬)와 같은 상태로 시작한다 — 첫 클릭은 오름차순이 된다 */}
          <th scope="col" data-sort-header="updated" aria-sort="descending">
            <button class="catalog-table__sort" type="button" data-sort="updated">
              최근 수정일
              <span class="catalog-table__sort-icon" aria-hidden="true">↓</span>
            </button>
          </th>
        </tr>
      </thead>
      <tbody data-deck-rows>
        {tableDecks.map((deck, index) => (
          <tr
            data-category={deck.category}
            data-updated={deck.updatedAt?.getTime() ?? ''}
            data-original-index={index}
            data-tags={tagIds(deck)}
          >
            <th scope="row">
              <a class="catalog-table__deck" href={deck.href}>
                <span class="catalog-table__icon" data-tone={deck.tone} aria-hidden="true">
                  <Icon name={deck.icon as any} size="1rem" />
                </span>
                <span>
                  <span class="catalog-table__name">{deck.title}</span>
                  <span class="catalog-table__blurb">{deck.desc}</span>
                  {/* 새 열이 아니라 덱 셀의 셋째 줄이다 — 열을 늘리면 min-width가 커져
                      이미 잘리는 blurb가 더 잘린다. */}
                  {/* 색인 제외는 래퍼의 data-pagefind-ignore가 이미 담당한다 */}
                  <span class="catalog-table__tags">
                    {deck.tags.map((tag) => (
                      <span class="deck__tag" data-axis={tag.axis}>{tag.label}</span>
                    ))}
                  </span>
                </span>
              </a>
            </th>
            <td><span class="catalog-table__category" data-tone={deck.tone}>{deck.category}</span></td>
            <td class="catalog-table__chapters">{deck.chapters}장</td>
            <td class="catalog-table__date">
              {deck.updatedAt ? (
                <time datetime={deck.updatedAt.toISOString()}>{formatDate(deck.updatedAt)}</time>
              ) : (
                <span aria-label="수정일 없음">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="sr-only" aria-live="polite" data-sort-status></p>
  </div>

  {/* 두 패널 바깥이어야 한다 — hidden 하위의 aria-live는 접근성 트리에 없어서
      아무것도 읽지 않는다. data-sort-status는 테이블 래퍼 안이라 재사용할 수 없다. */}
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <p class="catalog__empty" data-filter-empty hidden data-pagefind-ignore>
    선택한 태그를 모두 가진 덱이 없습니다.
    <button class="filter__clear" type="button" data-filter-clear>필터 지우기</button>
  </p>
</div>

<script>
  const VIEW_STORAGE_KEY = 'deck-catalog-view';
  // 태그 선택은 localStorage에 저장하지 않는다 — 지속되는 취향이 아니라 그때의 질의다.
  const TAGS_PARAM = 'tags';

  document.querySelectorAll<HTMLElement>('[data-deck-catalog]').forEach((catalog) => {
    const viewButtons = catalog.querySelectorAll<HTMLButtonElement>('[data-view-button]');
    const views = catalog.querySelectorAll<HTMLElement>('[data-catalog-view]');
    const rowsContainer = catalog.querySelector<HTMLTableSectionElement>('[data-deck-rows]');
    const sortButtons = catalog.querySelectorAll<HTMLButtonElement>('[data-sort]');
    const sortStatus = catalog.querySelector<HTMLElement>('[data-sort-status]');
    const collator = new Intl.Collator('ko-KR');

    const setView = (view: string) => {
      viewButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
      });
      views.forEach((panel) => {
        panel.hidden = panel.dataset.catalogView !== view;
      });
    };

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.viewButton ?? 'cards';
        setView(view);
        try {
          localStorage.setItem(VIEW_STORAGE_KEY, view);
        } catch {
          // 저장소가 차단된 환경에서도 현재 페이지의 전환은 유지한다.
        }
      });
    });

    try {
      const savedView = localStorage.getItem(VIEW_STORAGE_KEY);
      if (savedView === 'cards') setView(savedView);
    } catch {
      // localStorage를 읽을 수 없으면 기본 테이블 보기를 유지한다.
    }

    // ── 태그 필터 ────────────────────────────────────────────────────────────
    const chips = Array.from(catalog.querySelectorAll<HTMLButtonElement>('[data-tag]'));
    const clearButtons = catalog.querySelectorAll<HTMLButtonElement>('[data-filter-clear]');
    const barClear = catalog.querySelector<HTMLElement>('[data-tag-filter] [data-filter-clear]');
    const emptyState = catalog.querySelector<HTMLElement>('[data-filter-empty]');
    const filterStatus = catalog.querySelector<HTMLElement>('[data-filter-status]');
    const sectionEls = catalog.querySelectorAll<HTMLElement>('.catalog__section');

    // 문자열 includes는 'agent'가 'agent-platform'에 걸리는 접두 충돌이 난다.
    const tagSetOf = (el: HTMLElement) => new Set((el.dataset.tags ?? '').split(' ').filter(Boolean));
    const cardEntries = Array.from(catalog.querySelectorAll<HTMLElement>('.deck')).map((el) => ({
      el,
      tags: tagSetOf(el),
    }));
    const rowEntries = Array.from(catalog.querySelectorAll<HTMLElement>('[data-deck-rows] tr')).map((el) => ({
      el,
      tags: tagSetOf(el),
    }));

    const vocabulary = chips.map((chip) => chip.dataset.tag ?? '');
    const selected = new Set<string>();
    let announced = false;

    // 교집합 — 선택한 태그를 모두 가진 덱만 남는다.
    const matches = (tags: Set<string>) => Array.from(selected).every((tag) => tags.has(tag));

    const applyFilter = () => {
      // DOM에서 빼지 않고 hidden으로 감춘다. 정렬이 rowsContainer.rows를 재배치하므로
      // 제거하면 이후 정렬에서 영영 빠진다. hidden은 접근성 트리·탭 순서에서도 뺀다.
      for (const { el, tags } of cardEntries) el.hidden = !matches(tags);
      for (const { el, tags } of rowEntries) el.hidden = !matches(tags);

      // 헤딩만 덩그러니 남지 않게 섹션을 통째로 접는다.
      sectionEls.forEach((section) => {
        section.hidden = !section.querySelector('.deck:not([hidden])');
      });

      const visible = cardEntries.filter(({ el }) => !el.hidden);

      // 남은 덱 기준으로 칩 개수를 다시 센다. 0이 되는 칩은 막다른 길이라 흐리게 한다.
      // disabled 속성은 쓰지 않는다 — 탭 순서에서 빠지면 어느 칩이 죽었는지 알 수 없다.
      chips.forEach((chip) => {
        const tag = chip.dataset.tag ?? '';
        const isSelected = selected.has(tag);
        const count = isSelected ? visible.length : visible.filter(({ tags }) => tags.has(tag)).length;
        const chipCount = chip.querySelector<HTMLElement>('[data-chip-count]');
        if (chipCount) chipCount.textContent = String(count);
        chip.setAttribute('aria-disabled', String(!isSelected && count === 0));
      });

      if (emptyState) emptyState.hidden = visible.length > 0;
      if (barClear) barClear.hidden = selected.size === 0;

      // 첫 호출은 읽지 않는다 — 페이지가 뜨자마자 맥락 없는 안내가 나가는 걸 막는다.
      if (announced && filterStatus) {
        filterStatus.textContent =
          visible.length > 0 ? `${visible.length}개 덱이 조건에 맞습니다.` : '조건에 맞는 덱이 없습니다.';
      }
      announced = true;
    };

    const syncUrl = () => {
      const url = new URL(location.href);
      url.searchParams.delete(TAGS_PARAM);
      const others = url.searchParams.toString();
      // 클릭 순서가 아니라 어휘 순서로 — 같은 선택이면 늘 같은 URL이 된다.
      const value = vocabulary.filter((tag) => selected.has(tag)).join(',');
      // searchParams.set을 쓰면 쉼표가 %2C로 인코딩돼 링크가 읽기 어려워진다.
      // tag id는 [a-z0-9-]로 강제되므로(check-content) 이스케이프가 필요 없다.
      const search = value
        ? `?${others ? `${others}&` : ''}${TAGS_PARAM}=${value}`
        : others
          ? `?${others}`
          : '';
      // pushState면 칩을 누른 횟수만큼 뒤로가기가 필요하고 popstate 처리도 따라온다.
      history.replaceState(null, '', url.pathname + search + url.hash);
    };

    const syncPressed = () => {
      chips.forEach((chip) => {
        chip.setAttribute('aria-pressed', String(selected.has(chip.dataset.tag ?? '')));
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const tag = chip.dataset.tag;
        if (!tag || chip.getAttribute('aria-disabled') === 'true') return;
        if (selected.has(tag)) selected.delete(tag);
        else selected.add(tag);
        chip.setAttribute('aria-pressed', String(selected.has(tag)));
        applyFilter();
        syncUrl();
      });
    });

    clearButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selected.clear();
        syncPressed();
        applyFilter();
        syncUrl();
      });
    });

    const requestedTags = new URLSearchParams(location.search).get(TAGS_PARAM);
    if (requestedTags !== null) {
      // 모르는 id는 조용히 버린다 — 어휘가 바뀐 뒤의 오래된 링크는 깨지지 말고 무뎌져야 한다.
      const known = new Set(vocabulary);
      for (const tag of requestedTags.split(',')) {
        if (known.has(tag)) selected.add(tag);
      }
      syncPressed();
    }
    applyFilter();
    if (requestedTags !== null) syncUrl();

    sortButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!rowsContainer) return;

        const key = button.dataset.sort;
        if (key !== 'category' && key !== 'updated') return;

        const header = button.closest<HTMLTableCellElement>('th');
        const currentDirection = header?.getAttribute('aria-sort');
        const direction = currentDirection === 'ascending' ? 'descending' : 'ascending';
        const directionFactor = direction === 'ascending' ? 1 : -1;
        const rows = Array.from(rowsContainer.rows);

        rows.sort((a, b) => {
          let result = 0;

          if (key === 'category') {
            result = collator.compare(a.dataset.category ?? '', b.dataset.category ?? '');
          } else {
            const aUpdated = Number(a.dataset.updated);
            const bUpdated = Number(b.dataset.updated);
            const aMissing = !a.dataset.updated;
            const bMissing = !b.dataset.updated;

            if (aMissing !== bMissing) return aMissing ? 1 : -1;
            result = aUpdated - bUpdated;
          }

          if (result === 0) {
            return Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex);
          }
          return result * directionFactor;
        });

        rowsContainer.append(...rows);

        catalog.querySelectorAll<HTMLTableCellElement>('[data-sort-header]').forEach((sortHeader) => {
          const active = sortHeader === header;
          sortHeader.setAttribute('aria-sort', active ? direction : 'none');
          const icon = sortHeader.querySelector<HTMLElement>('.catalog-table__sort-icon');
          if (icon) icon.textContent = active ? (direction === 'ascending' ? '↑' : '↓') : '↕';
        });

        if (sortStatus) {
          const label = key === 'category' ? '카테고리' : '최근 수정일';
          sortStatus.textContent = `${label} ${direction === 'ascending' ? '오름차순' : '내림차순'}으로 정렬했습니다.`;
        }
      });
    });
  });
</script>

