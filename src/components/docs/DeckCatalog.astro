---
/*
  랜딩(/)의 덱 목록 — 카테고리 카드 · 정렬 가능한 테이블.

  카드 보기는 덱을 카테고리로 묶어 처음 둘러보기 좋게 하고,
  테이블 보기는 덱이 많을 때 전체를 빠르게 비교하게 한다.
  테이블의 카테고리와 최근 수정일 제목행은 버튼이며, 누를 때마다 오름차순과
  내림차순을 바꾼다. 현재 보기는 localStorage에 저장한다.

  sections: 카테고리 하나 = 섹션 하나
    title  카테고리 이름 (h2)
    desc   카테고리 한 줄 설명
    tone   mermaid classDef · DeckMap과 같은 여섯 팔레트 — 카테고리 식별색
    decks  덱 카드 목록
      slug      덱 slug — 수정일을 계산할 콘텐츠 경로
      href      덱 index 링크 ('/cka/')
      icon      Starlight 아이콘 이름 — src/data/decks.mjs의 topic과 같은 값
      title     덱 이름
      desc      한 줄 소개 (평문 — 서식 처리 없음)
      chapters  장 수 — 카드 오른쪽 위 분량 표시

  각 덱의 최종 수정일은 Starlight가 페이지 수정일에 쓰는 Git 이력에서 가져온다.
  파일 시스템 mtime은 배포 체크아웃 시각으로 바뀌므로 사용하지 않는다. 덱의 index와
  등록된 장 중 하나라도 커밋되면 가장 최신 날짜가 자동으로 카드에 반영된다.

  덱을 추가하면 src/data/decks.mjs 한 곳만 고친다.
*/
import { Icon } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import { getNewestCommitDate } from 'virtual:starlight/git-info';

type Tone = 'key' | 'ok' | 'warn' | 'bad' | 'mute' | 'zone';

interface Deck {
  slug: string;
  href: string;
  icon: string;
  title: string;
  desc: string;
  chapters: number;
}

interface Section {
  title: string;
  desc: string;
  tone: Tone;
  decks: Deck[];
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const docs = await getCollection('docs');

const sectionsWithDates = sections.map((section) => ({
  ...section,
  decks: section.decks.map((deck) => {
    const dates = docs
      .filter((entry) => entry.id === deck.slug || entry.id.startsWith(`${deck.slug}/`))
      .flatMap((entry) => {
        try {
          return [getNewestCommitDate(entry.filePath)];
        } catch {
          // 새 파일처럼 아직 Git 이력이 없는 문서는 날짜 계산에서 제외한다.
          return [];
        }
      });

    return {
      ...deck,
      updatedAt: dates.length > 0 ? new Date(Math.max(...dates.map((date) => date.getTime()))) : undefined,
    };
  }),
}));

const tableDecks = sectionsWithDates.flatMap((section) =>
  section.decks.map((deck) => ({
    ...deck,
    category: section.title,
    tone: section.tone,
  })),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
    timeZone: 'Asia/Seoul',
  });
---

<div class="catalog" data-deck-catalog>
  <div class="catalog__toolbar" role="group" aria-label="덱 표시 방식">
    <span class="catalog__toolbar-label">보기</span>
    <div class="catalog__view-switch">
      <button class="catalog__view-button" type="button" data-view-button="cards" aria-pressed="true">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <rect x="1.5" y="1.5" width="5" height="5" rx="1"></rect>
          <rect x="9.5" y="1.5" width="5" height="5" rx="1"></rect>
          <rect x="1.5" y="9.5" width="5" height="5" rx="1"></rect>
          <rect x="9.5" y="9.5" width="5" height="5" rx="1"></rect>
        </svg>
        카드
      </button>
      <button class="catalog__view-button" type="button" data-view-button="table" aria-pressed="false">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 3.5h12M2 8h12M2 12.5h12"></path>
        </svg>
        테이블
      </button>
    </div>
  </div>

  <div data-catalog-view="cards">
    {sectionsWithDates.map((section) => (
      <section class="catalog__section" data-tone={section.tone}>
        <header class="catalog__head">
          <h2 class="catalog__title">{section.title}</h2>
          <p class="catalog__desc">{section.desc}</p>
        </header>
        <div class="catalog__grid">
          {section.decks.map((deck) => (
            <a class="deck" href={deck.href}>
              <span class="deck__icon" aria-hidden="true">
                <Icon name={deck.icon as any} size="1.25rem" />
              </span>
              <span class="deck__body">
                <span class="deck__row">
                  <span class="deck__name">{deck.title}</span>
                  <span class="deck__meta">{deck.chapters}장</span>
                </span>
                <span class="deck__blurb">{deck.desc}</span>
                {deck.updatedAt && (
                  <span class="deck__updated">
                    마지막 수정 <time datetime={deck.updatedAt.toISOString()}>{formatDate(deck.updatedAt)}</time>
                  </span>
                )}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <div class="catalog-table-wrap" data-catalog-view="table" hidden>
    <table class="catalog-table">
      <thead>
        <tr>
          <th scope="col">덱</th>
          <th scope="col" data-sort-header="category" aria-sort="none">
            <button class="catalog-table__sort" type="button" data-sort="category">
              카테고리
              <span class="catalog-table__sort-icon" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col">분량</th>
          <th scope="col" data-sort-header="updated" aria-sort="none">
            <button class="catalog-table__sort" type="button" data-sort="updated">
              최근 수정일
              <span class="catalog-table__sort-icon" aria-hidden="true">↕</span>
            </button>
          </th>
        </tr>
      </thead>
      <tbody data-deck-rows>
        {tableDecks.map((deck, index) => (
          <tr
            data-category={deck.category}
            data-updated={deck.updatedAt?.getTime() ?? ''}
            data-original-index={index}
          >
            <th scope="row">
              <a class="catalog-table__deck" href={deck.href}>
                <span class="catalog-table__icon" data-tone={deck.tone} aria-hidden="true">
                  <Icon name={deck.icon as any} size="1rem" />
                </span>
                <span>
                  <span class="catalog-table__name">{deck.title}</span>
                  <span class="catalog-table__blurb">{deck.desc}</span>
                </span>
              </a>
            </th>
            <td><span class="catalog-table__category" data-tone={deck.tone}>{deck.category}</span></td>
            <td class="catalog-table__chapters">{deck.chapters}장</td>
            <td class="catalog-table__date">
              {deck.updatedAt ? (
                <time datetime={deck.updatedAt.toISOString()}>{formatDate(deck.updatedAt)}</time>
              ) : (
                <span aria-label="수정일 없음">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="sr-only" aria-live="polite" data-sort-status></p>
  </div>
</div>

<script>
  const VIEW_STORAGE_KEY = 'deck-catalog-view';

  document.querySelectorAll<HTMLElement>('[data-deck-catalog]').forEach((catalog) => {
    const viewButtons = catalog.querySelectorAll<HTMLButtonElement>('[data-view-button]');
    const views = catalog.querySelectorAll<HTMLElement>('[data-catalog-view]');
    const rowsContainer = catalog.querySelector<HTMLTableSectionElement>('[data-deck-rows]');
    const sortButtons = catalog.querySelectorAll<HTMLButtonElement>('[data-sort]');
    const sortStatus = catalog.querySelector<HTMLElement>('[data-sort-status]');
    const collator = new Intl.Collator('ko-KR');

    const setView = (view: string) => {
      viewButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
      });
      views.forEach((panel) => {
        panel.hidden = panel.dataset.catalogView !== view;
      });
    };

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.viewButton ?? 'cards';
        setView(view);
        try {
          localStorage.setItem(VIEW_STORAGE_KEY, view);
        } catch {
          // 저장소가 차단된 환경에서도 현재 페이지의 전환은 유지한다.
        }
      });
    });

    try {
      const savedView = localStorage.getItem(VIEW_STORAGE_KEY);
      if (savedView === 'table') setView(savedView);
    } catch {
      // localStorage를 읽을 수 없으면 기본 카드 보기를 유지한다.
    }

    sortButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!rowsContainer) return;

        const key = button.dataset.sort;
        if (key !== 'category' && key !== 'updated') return;

        const header = button.closest<HTMLTableCellElement>('th');
        const currentDirection = header?.getAttribute('aria-sort');
        const direction = currentDirection === 'ascending' ? 'descending' : 'ascending';
        const directionFactor = direction === 'ascending' ? 1 : -1;
        const rows = Array.from(rowsContainer.rows);

        rows.sort((a, b) => {
          let result = 0;

          if (key === 'category') {
            result = collator.compare(a.dataset.category ?? '', b.dataset.category ?? '');
          } else {
            const aUpdated = Number(a.dataset.updated);
            const bUpdated = Number(b.dataset.updated);
            const aMissing = !a.dataset.updated;
            const bMissing = !b.dataset.updated;

            if (aMissing !== bMissing) return aMissing ? 1 : -1;
            result = aUpdated - bUpdated;
          }

          if (result === 0) {
            return Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex);
          }
          return result * directionFactor;
        });

        rowsContainer.append(...rows);

        catalog.querySelectorAll<HTMLTableCellElement>('[data-sort-header]').forEach((sortHeader) => {
          const active = sortHeader === header;
          sortHeader.setAttribute('aria-sort', active ? direction : 'none');
          const icon = sortHeader.querySelector<HTMLElement>('.catalog-table__sort-icon');
          if (icon) icon.textContent = active ? (direction === 'ascending' ? '↑' : '↓') : '↕';
        });

        if (sortStatus) {
          const label = key === 'category' ? '카테고리' : '최근 수정일';
          sortStatus.textContent = `${label} ${direction === 'ascending' ? '오름차순' : '내림차순'}으로 정렬했습니다.`;
        }
      });
    });
  });
</script>

<style>
  /* 의미 팔레트 — mermaid classDef · DeckMap과 같은 여섯 색 */
  .catalog__section[data-tone='key']  { --dc-line: #2563eb; --dc-bg: #dbeafe; --dc-fg: #1e3a8a; }
  .catalog__section[data-tone='ok']   { --dc-line: #16a34a; --dc-bg: #dcfce7; --dc-fg: #14532d; }
  .catalog__section[data-tone='warn'] { --dc-line: #d97706; --dc-bg: #fef3c7; --dc-fg: #78350f; }
  .catalog__section[data-tone='bad']  { --dc-line: #dc2626; --dc-bg: #fee2e2; --dc-fg: #7f1d1d; }
  .catalog__section[data-tone='zone'] { --dc-line: #7c3aed; --dc-bg: #ede9fe; --dc-fg: #4c1d95; }
  .catalog__section[data-tone='mute'] { --dc-line: #94a3b8; --dc-bg: #f1f5f9; --dc-fg: #334155; }

  :global([data-theme='dark']) .catalog__section[data-tone='key']  { --dc-bg: #1e3a8a; --dc-fg: #bfdbfe; }
  :global([data-theme='dark']) .catalog__section[data-tone='ok']   { --dc-bg: #14532d; --dc-fg: #bbf7d0; }
  :global([data-theme='dark']) .catalog__section[data-tone='warn'] { --dc-bg: #78350f; --dc-fg: #fde68a; }
  :global([data-theme='dark']) .catalog__section[data-tone='bad']  { --dc-bg: #7f1d1d; --dc-fg: #fecaca; }
  :global([data-theme='dark']) .catalog__section[data-tone='zone'] { --dc-bg: #4c1d95; --dc-fg: #ddd6fe; }
  :global([data-theme='dark']) .catalog__section[data-tone='mute'] { --dc-bg: #334155; --dc-fg: #cbd5e1; }

  .catalog {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .catalog__toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.65rem;
  }
  .catalog__toolbar-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
  .catalog__view-switch {
    display: inline-flex;
    padding: 0.2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-7);
  }
  .catalog__view-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .catalog__view-button svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .catalog__view-button[aria-pressed='true'] {
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--sl-color-black) 12%, transparent);
  }
  .catalog__view-button:focus-visible,
  .catalog-table__sort:focus-visible,
  .catalog-table__deck:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  [data-catalog-view='cards'] {
    display: grid;
    gap: 2.75rem;
  }
  [data-catalog-view][hidden] {
    display: none;
  }

  .catalog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.75rem;
    border-inline-start: 4px solid var(--dc-line);
    padding-inline-start: 0.75rem;
    margin-bottom: 1rem;
  }
  .catalog__title {
    font-size: var(--sl-text-xl);
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .catalog__desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.9rem;
  }

  .deck {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem 1.05rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .deck:hover {
    border-color: var(--dc-line);
    box-shadow: 0 3px 14px -6px color-mix(in srgb, var(--dc-line) 45%, transparent);
    transform: translateY(-2px);
  }

  .deck__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.55rem;
    background: var(--dc-bg);
    color: var(--dc-fg);
  }

  .deck__body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .deck__row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .deck__name {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.35;
    color: var(--sl-color-white);
  }
  .deck:hover .deck__name {
    color: var(--dc-line);
  }
  .deck__meta {
    flex: none;
    margin-inline-start: auto;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.05rem 0.4rem;
    border-radius: 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .deck__blurb {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .deck__updated {
    margin-top: 0.05rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--sl-color-gray-3);
  }

  .catalog-table-wrap {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
  }
  .catalog-table {
    width: 100%;
    min-width: 43rem;
    border: 0;
    border-collapse: collapse;
    margin: 0;
    font-size: 0.86rem;
  }
  .catalog-table :is(th, td) {
    border: 0;
    border-bottom: 1px solid var(--sl-color-gray-6);
    padding: 0.75rem 0.85rem;
    text-align: start;
    vertical-align: middle;
  }
  .catalog-table thead th {
    position: sticky;
    top: 0;
    background: var(--sl-color-gray-7);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .catalog-table tbody tr:last-child :is(th, td) {
    border-bottom: 0;
  }
  .catalog-table tbody tr:hover {
    background: color-mix(in srgb, var(--sl-color-accent-low) 35%, transparent);
  }
  .catalog-table tbody th {
    width: 52%;
    font-weight: inherit;
  }
  .catalog-table__sort {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: -0.3rem;
    padding: 0.3rem;
    border: 0;
    border-radius: 0.3rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .catalog-table__sort:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .catalog-table__sort-icon {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
  }
  [aria-sort='ascending'] .catalog-table__sort-icon,
  [aria-sort='descending'] .catalog-table__sort-icon {
    color: var(--sl-color-accent-high);
  }
  .catalog-table__deck {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    text-decoration: none;
  }
  .catalog-table__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    background: var(--dc-bg);
    color: var(--dc-fg);
  }
  .catalog-table__icon[data-tone='key'],
  .catalog-table__category[data-tone='key'] { --dc-bg: #dbeafe; --dc-fg: #1e3a8a; }
  .catalog-table__icon[data-tone='ok'],
  .catalog-table__category[data-tone='ok'] { --dc-bg: #dcfce7; --dc-fg: #14532d; }
  .catalog-table__icon[data-tone='warn'],
  .catalog-table__category[data-tone='warn'] { --dc-bg: #fef3c7; --dc-fg: #78350f; }
  .catalog-table__icon[data-tone='bad'],
  .catalog-table__category[data-tone='bad'] { --dc-bg: #fee2e2; --dc-fg: #7f1d1d; }
  .catalog-table__icon[data-tone='zone'],
  .catalog-table__category[data-tone='zone'] { --dc-bg: #ede9fe; --dc-fg: #4c1d95; }
  .catalog-table__icon[data-tone='mute'],
  .catalog-table__category[data-tone='mute'] { --dc-bg: #f1f5f9; --dc-fg: #334155; }
  :global([data-theme='dark']) .catalog-table__icon[data-tone='key'],
  :global([data-theme='dark']) .catalog-table__category[data-tone='key'] { --dc-bg: #1e3a8a; --dc-fg: #bfdbfe; }
  :global([data-theme='dark']) .catalog-table__icon[data-tone='ok'],
  :global([data-theme='dark']) .catalog-table__category[data-tone='ok'] { --dc-bg: #14532d; --dc-fg: #bbf7d0; }
  :global([data-theme='dark']) .catalog-table__icon[data-tone='warn'],
  :global([data-theme='dark']) .catalog-table__category[data-tone='warn'] { --dc-bg: #78350f; --dc-fg: #fde68a; }
  :global([data-theme='dark']) .catalog-table__icon[data-tone='bad'],
  :global([data-theme='dark']) .catalog-table__category[data-tone='bad'] { --dc-bg: #7f1d1d; --dc-fg: #fecaca; }
  :global([data-theme='dark']) .catalog-table__icon[data-tone='zone'],
  :global([data-theme='dark']) .catalog-table__category[data-tone='zone'] { --dc-bg: #4c1d95; --dc-fg: #ddd6fe; }
  :global([data-theme='dark']) .catalog-table__icon[data-tone='mute'],
  :global([data-theme='dark']) .catalog-table__category[data-tone='mute'] { --dc-bg: #334155; --dc-fg: #cbd5e1; }
  .catalog-table__name {
    display: block;
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.35;
  }
  .catalog-table__deck:hover .catalog-table__name {
    color: var(--sl-color-accent-high);
  }
  .catalog-table__blurb {
    display: block;
    margin-top: 0.15rem;
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .catalog-table__category {
