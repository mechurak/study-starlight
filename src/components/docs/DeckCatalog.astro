---
/*
  랜딩(/)의 덱 목록 — 카테고리 섹션 × 덱 카드.

  원래 랜딩은 hero 액션 12개 + 평면 CardGrid 12장이었다. 덱이 늘면서
  액션 줄은 읽을 수 없는 링크 띠가 됐고, 카드 그리드는 분류 없이 길어져
  "무엇부터 볼지"가 안 보였다. 이 컴포넌트는 덱을 카테고리로 묶고,
  카드 전체를 링크로 만들어 목록 자체가 내비게이션이 되게 한다.

  sections: 카테고리 하나 = 섹션 하나
    title  카테고리 이름 (h2)
    desc   카테고리 한 줄 설명
    tone   mermaid classDef · DeckMap과 같은 여섯 팔레트 — 카테고리 식별색
    decks  덱 카드 목록
      href      덱 index 링크 ('/cka/')
      icon      Starlight 아이콘 이름 — src/data/decks.mjs의 topic과 같은 값
      title     덱 이름
      desc      한 줄 소개 (평문 — 서식 처리 없음)
      chapters  장 수 — 카드 오른쪽 위 분량 표시

  덱을 추가하면 src/data/decks.mjs 한 곳만 고친다.
*/
import { Icon } from '@astrojs/starlight/components';

type Tone = 'key' | 'ok' | 'warn' | 'bad' | 'mute' | 'zone';

interface Deck {
  href: string;
  icon: string;
  title: string;
  desc: string;
  chapters: number;
}

interface Section {
  title: string;
  desc: string;
  tone: Tone;
  decks: Deck[];
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<div class="catalog">
  {sections.map((section) => (
    <section class="catalog__section" data-tone={section.tone}>
      <header class="catalog__head">
        <h2 class="catalog__title">{section.title}</h2>
        <p class="catalog__desc">{section.desc}</p>
      </header>
      <div class="catalog__grid">
        {section.decks.map((deck) => (
          <a class="deck" href={deck.href}>
            <span class="deck__icon" aria-hidden="true">
              <Icon name={deck.icon as any} size="1.25rem" />
            </span>
            <span class="deck__body">
              <span class="deck__row">
                <span class="deck__name">{deck.title}</span>
                <span class="deck__meta">{deck.chapters}장</span>
              </span>
              <span class="deck__blurb">{deck.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  /* 의미 팔레트 — mermaid classDef · DeckMap과 같은 여섯 색 */
  .catalog__section[data-tone='key']  { --dc-line: #2563eb; --dc-bg: #dbeafe; --dc-fg: #1e3a8a; }
  .catalog__section[data-tone='ok']   { --dc-line: #16a34a; --dc-bg: #dcfce7; --dc-fg: #14532d; }
  .catalog__section[data-tone='warn'] { --dc-line: #d97706; --dc-bg: #fef3c7; --dc-fg: #78350f; }
  .catalog__section[data-tone='bad']  { --dc-line: #dc2626; --dc-bg: #fee2e2; --dc-fg: #7f1d1d; }
  .catalog__section[data-tone='zone'] { --dc-line: #7c3aed; --dc-bg: #ede9fe; --dc-fg: #4c1d95; }
  .catalog__section[data-tone='mute'] { --dc-line: #94a3b8; --dc-bg: #f1f5f9; --dc-fg: #334155; }

  :global([data-theme='dark']) .catalog__section[data-tone='key']  { --dc-bg: #1e3a8a; --dc-fg: #bfdbfe; }
  :global([data-theme='dark']) .catalog__section[data-tone='ok']   { --dc-bg: #14532d; --dc-fg: #bbf7d0; }
  :global([data-theme='dark']) .catalog__section[data-tone='warn'] { --dc-bg: #78350f; --dc-fg: #fde68a; }
  :global([data-theme='dark']) .catalog__section[data-tone='bad']  { --dc-bg: #7f1d1d; --dc-fg: #fecaca; }
  :global([data-theme='dark']) .catalog__section[data-tone='zone'] { --dc-bg: #4c1d95; --dc-fg: #ddd6fe; }
  :global([data-theme='dark']) .catalog__section[data-tone='mute'] { --dc-bg: #334155; --dc-fg: #cbd5e1; }

  .catalog {
    display: grid;
    gap: 2.75rem;
    margin-top: 1rem;
  }

  .catalog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.75rem;
    border-inline-start: 4px solid var(--dc-line);
    padding-inline-start: 0.75rem;
    margin-bottom: 1rem;
  }
  .catalog__title {
    font-size: var(--sl-text-xl);
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .catalog__desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.9rem;
  }

  .deck {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem 1.05rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .deck:hover {
    border-color: var(--dc-line);
    box-shadow: 0 3px 14px -6px color-mix(in srgb, var(--dc-line) 45%, transparent);
    transform: translateY(-2px);
  }

  .deck__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.55rem;
    background: var(--dc-bg);
    color: var(--dc-fg);
  }

  .deck__body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .deck__row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .deck__name {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.35;
    color: var(--sl-color-white);
  }
  .deck:hover .deck__name {
    color: var(--dc-line);
  }
  .deck__meta {
    flex: none;
    margin-inline-start: auto;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.05rem 0.4rem;
    border-radius: 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .deck__blurb {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  @media (max-width: 30rem) {
    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
